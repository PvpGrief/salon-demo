# Copy to .env (local development) and fill in. Never commit .env.
# For Cloudflare local dev the same values are read from .env.
# In production set them in the hosting dashboard (see README.md).

# Supabase → Project Settings → API (Data API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon" (legacy) or "publishable" key – safe for public data, RLS applies
SUPABASE_ANON_KEY=
# "service_role" (legacy) or "secret" key – SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Brevo API key for confirmation e-mails. Leave empty to disable e-mails.
BREVO_API_KEY=

# Optional: production URL override (otherwise business.siteUrl from src/config/business.ts)
# SITE_URL=https://www.example.lv

# Optional: hosting target for the build: cloudflare (default) | netlify | node
# DEPLOY_TARGET=cloudflare
