---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---

<Base title="Lapa nav atrasta" noindex>
  <section class="container-page py-20 text-center">
    <p class="text-6xl font-semibold text-brand">404</p>
    <h1 class="mt-4 text-3xl font-semibold">Lapa nav atrasta</h1>
    <p class="mt-3 text-muted">Iespējams, saite ir novecojusi vai tajā ir kļūda.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Uz sākumlapu</a>
      <a href="/pieteikties" class="btn-outline">Pieteikties vizītei</a>
    </div>
  </section>
</Base>
