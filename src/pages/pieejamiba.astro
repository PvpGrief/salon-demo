---
/**
 * Public availability view: who is free / busy on a given day.
 * Shows only time ranges – never customer names or block reasons.
 * Server-rendered, no JavaScript needed.
 */
import Base from '../layouts/Base.astro';
import { t } from '../config/texts';
import { loadBusy, loadCatalogue, type Catalogue } from '../lib/booking/availability';
import { dayTimeline, type TimeWindow } from '../lib/booking/slots';
import { publicClient } from '../lib/supabase';
import {
  addDays,
  diffDays,
  formatDate,
  formatDateShort,
  formatDateWithWeekday,
  isDateString,
  minutesToTime,
  rigaMinutesOfDay,
  startOfWeek,
  todayRiga,
  weekdayShort,
} from '../lib/time';

const today = todayRiga();
const requested = Astro.url.searchParams.get('diena');
let day = isDateString(requested) && diffDays(today, requested!) >= 0 ? requested! : today;

let cat: Catalogue | null = null;
let busy: Awaited<ReturnType<typeof loadBusy>> = [];
try {
  const supabase = publicClient();
  cat = await loadCatalogue(supabase);
  if (diffDays(today, day) > cat.settings.max_days_ahead) day = today;
  busy = await loadBusy(supabase, day, 1);
} catch (e) {
  console.error('[pieejamiba]', e);
}

const maxDay = addDays(today, cat?.settings.max_days_ahead ?? 60);
const weekStart = startOfWeek(day);
const week = Array.from({ length: 7 }, (_, i) => addDays(weekStart, i));
const prevWeek = addDays(weekStart, -7);
const nextWeek = addDays(weekStart, 7);
const closedReason = cat?.closedDays.get(day);
const isClosed = cat?.closedDays.has(day) ?? false;

// On today, hide what is already in the past.
const nowMin = day === today ? Math.ceil(rigaMinutesOfDay(new Date()) / 15) * 15 : 0;

const rows = (cat?.masters ?? []).map((m) => {
  const tl = dayTimeline({ date: day, masterId: m.id, workingHours: cat!.workingHours, closedDays: cat!.closedDays.keys(), busy });
  const free = tl.free
    .map((w) => ({ start: Math.max(w.start, nowMin), end: w.end }))
    .filter((w) => w.end - w.start >= 15);
  return { master: m, ...tl, free };
});

// Shared scale for the timeline bars.
const allWork = rows.flatMap((r) => r.working);
const scaleStart = allWork.length ? Math.floor(Math.min(...allWork.map((w) => w.start)) / 60) * 60 : 9 * 60;
const scaleEnd = allWork.length ? Math.ceil(Math.max(...allWork.map((w) => w.end)) / 60) * 60 : 18 * 60;
const span = Math.max(60, scaleEnd - scaleStart);
const pct = (min: number) => `${(((min - scaleStart) / span) * 100).toFixed(3)}%`;
const width = (w: TimeWindow) => `${(((w.end - w.start) / span) * 100).toFixed(3)}%`;
const hourTicks = Array.from({ length: span / 60 + 1 }, (_, i) => scaleStart + i * 60);
const fmtWin = (w: TimeWindow) => `${minutesToTime(w.start)}–${minutesToTime(w.end)}`;
---

<Base title={t.availability.title} description="Skatiet, kuri meistari ir brīvi un kad – un pierakstieties tiešsaistē.">
  <section class="container-page py-8 sm:py-12">
    <h1 class="text-3xl font-semibold sm:text-4xl">{t.availability.title}</h1>
    <p class="mt-2 max-w-2xl text-muted">{t.availability.intro}</p>

    <nav class="mt-6" aria-label="Datuma izvēle">
      <div class="flex items-center justify-between gap-2">
        {
          diffDays(today, addDays(prevWeek, 6)) >= 0 ? (
            <a class="btn-ghost !min-h-9 !px-3 text-sm" href={`?diena=${diffDays(today, prevWeek) >= 0 ? prevWeek : today}`}>
              ‹ <span class="hidden sm:inline">{t.availability.prevWeek}</span>
            </a>
          ) : (
            <span class="w-10" />
          )
        }
        <p class="text-sm font-medium text-muted">{formatDate(week[0])} – {formatDate(week[6])}</p>
        {
          diffDays(maxDay, nextWeek) <= 0 ? (
            <a class="btn-ghost !min-h-9 !px-3 text-sm" href={`?diena=${nextWeek}`}>
              <span class="hidden sm:inline">{t.availability.nextWeek}</span> ›
            </a>
          ) : (
            <span class="w-10" />
          )
        }
      </div>
      <ul class="mt-2 grid grid-cols-7 gap-1.5 sm:gap-2">
        {
          week.map((d) => {
            const disabled = diffDays(today, d) < 0 || diffDays(maxDay, d) > 0;
            const selected = d === day;
            const cls = `flex flex-col items-center rounded-2xl border px-1 py-2 text-sm ${
              selected ? 'border-brand bg-brand text-white' : disabled ? 'border-transparent text-muted/50' : 'border-line bg-surface hover:border-brand'
            }`;
            return (
              <li>
                {disabled ? (
                  <span class={cls} aria-disabled="true">
                    <span class="text-xs font-medium uppercase">{weekdayShort(d)}</span>
                    <span class="font-semibold tabular-nums">{formatDateShort(d)}</span>
                  </span>
                ) : (
                  <a class={cls} href={`?diena=${d}`} aria-current={selected ? 'date' : undefined}>
                    <span class="text-xs font-medium uppercase">{weekdayShort(d)}</span>
                    <span class="font-semibold tabular-nums">{formatDateShort(d)}</span>
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <h2 class="mt-8 text-2xl font-semibold">{formatDateWithWeekday(day)}</h2>

    {!cat && <p class="alert-error mt-4">{t.errors.generic}</p>}

    {
      isClosed ? (
        <p class="alert-info mt-4">
          {t.availability.closedDay}
          {closedReason ? ` – ${closedReason}` : ''}.
        </p>
      ) : (
        <>
          <ul class="mt-3 flex flex-wrap gap-4 text-sm text-muted" aria-hidden="true">
            <li class="flex items-center gap-2">
              <span class="inline-block size-3 rounded-sm bg-emerald-400/70" />
              {t.availability.free}
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-block size-3 rounded-sm bg-brand" />
              {t.availability.busy}
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-block size-3 rounded-sm border border-line bg-bg" />
              {t.availability.notWorking}
            </li>
          </ul>
          <ul class="mt-4 space-y-4">
            {rows.map(({ master: m, working, busy: busyWin, free }) => (
              <li class="card p-4 sm:p-5">
                <div class="flex items-center gap-3">
                  <img
                    src={m.photo_url || '/images/masters/placeholder.svg'}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    class="size-12 rounded-full bg-brand-soft object-cover object-top"
                  />
                  <div class="min-w-0 flex-1">
                    <h3 class="font-semibold">{m.name}</h3>
                    {m.title && <p class="text-sm text-muted">{m.title}</p>}
                  </div>
                  {free.length > 0 && (
                    <a class="btn-outline !min-h-9 shrink-0 !px-4 !py-1.5 text-sm" href={`/pieteikties?meistars=${m.id}`}>
                      {t.availability.book}
                    </a>
                  )}
                </div>

                {working.length === 0 ? (
                  <p class="mt-3 text-sm text-muted">{t.availability.notWorking}</p>
                ) : (
                  <>
                    <div class="relative mt-4 h-7 overflow-hidden rounded-lg border border-line bg-bg" aria-hidden="true">
                      {working.map((w) => (
                        <span class="absolute inset-y-0 bg-emerald-400/60" style={`left:${pct(w.start)};width:${width(w)}`} />
                      ))}
                      {busyWin.map((w) => (
                        <span class="absolute inset-y-0 bg-brand" style={`left:${pct(w.start)};width:${width(w)}`} />
                      ))}
                      {nowMin > scaleStart && (
                        <span class="absolute inset-y-0 left-0 bg-bg/70" style={`width:${pct(Math.min(nowMin, scaleEnd))}`} />
                      )}
                    </div>
                    <div class="relative mt-1 h-4 text-[11px] text-muted" aria-hidden="true">
                      {hourTicks.map((h, i) =>
                        i % (span > 8 * 60 ? 2 : 1) === 0 ? (
                          <span class="absolute -translate-x-1/2 tabular-nums" style={`left:${pct(h)}`}>
                            {minutesToTime(h).slice(0, 2)}
                          </span>
                        ) : null,
                      )}
                    </div>
                    <p class="mt-3 text-sm">
                      {free.length > 0 ? (
                        <>
                          <span class="font-semibold text-emerald-800">{t.availability.freeWindows}:</span>{' '}
                          <span class="tabular-nums">{free.map(fmtWin).join(', ')}</span>
                        </>
                      ) : (
                        <span class="text-muted">{t.availability.noFree}</span>
                      )}
                    </p>
                  </>
                )}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>
