---
import { actions, isInputError } from 'astro:actions';
import Admin from '../../layouts/Admin.astro';
import { business } from '../../config/business';
import { emailStatus } from '../../lib/email';

const save = Astro.getActionResult(actions.admin.saveSettings);
const pw = Astro.getActionResult(actions.admin.changePassword);
const anon = Astro.getActionResult(actions.admin.anonymizeOld);
if (save && !save.error) return Astro.redirect('/admin/iestatijumi?ok=saglabats');
if (pw && !pw.error) return Astro.redirect('/admin/iestatijumi?ok=parole');
if (anon && !anon.error) return Astro.redirect('/admin/iestatijumi?ok=anonimizets');

const supabase = Astro.locals.supabase!;
const { data: s } = await supabase.from('settings').select('*').eq('id', 1).single();
const mail = emailStatus();
const providerName = { resend: 'Resend', brevo: 'Brevo' } as const;
const errOf = (r: typeof save | typeof pw) =>
  r?.error ? (isInputError(r.error) ? Object.values(r.error.fields).flat()[0] ?? 'Pārbaudiet laukus.' : r.error.message) : null;

const fields = [
  { name: 'slotStepMin', label: 'Laika solis (min)', hint: 'Cik bieži sākas brīvie laiki: 15 → 10:00, 10:15, 10:30…', value: s?.slot_step_min, min: 5, max: 120 },
  { name: 'bufferMin', label: 'Pauze starp pierakstiem (min)', hint: 'Laiks sakopšanai pēc katra klienta.', value: s?.buffer_min, min: 0, max: 120 },
  { name: 'minNoticeMin', label: 'Minimālais laiks līdz vizītei (min)', hint: '120 = tiešsaistē nevar pierakstīties tuvāk par 2 stundām.', value: s?.min_notice_min, min: 0, max: 10080 },
  { name: 'maxDaysAhead', label: 'Cik dienas uz priekšu var pierakstīties', hint: '', value: s?.max_days_ahead, min: 1, max: 365 },
  { name: 'cancelHours', label: 'Klients var atcelt ne vēlāk kā (h pirms vizītes)', hint: 'Atcelšana ar saiti e-pastā.', value: s?.cancel_hours, min: 0, max: 720 },
  { name: 'maxActivePerPhone', label: 'Maks. aktīvo pierakstu uz vienu e-pastu', hint: 'Aizsardzība pret ļaunprātīgiem tiešsaistes pierakstiem.', value: s?.max_active_per_phone, min: 1, max: 50 },
  { name: 'retentionMonths', label: 'Klientu datu glabāšana (mēneši)', hint: 'Pēc tam vārds, tālrunis un e-pasts tiek dzēsti (VDAR).', value: s?.retention_months, min: 1, max: 120 },
];
---

<Admin title="Iestatījumi">
  <h1 class="text-2xl font-semibold">Iestatījumi</h1>

  <div class="mt-4 grid gap-6 lg:grid-cols-[2fr_1fr]">
    <form method="POST" action={actions.admin.saveSettings} class="card space-y-4 p-4 sm:p-5">
      <h2 class="text-lg font-semibold">Pieraksta noteikumi</h2>
      {errOf(save) && <p class="alert-error">{errOf(save)}</p>}
      <div class="grid gap-4 sm:grid-cols-2">
        {
          fields.map((f) => (
            <div>
              <label class="label" for={f.name}>{f.label}</label>
              <input id={f.name} name={f.name} type="number" min={f.min} max={f.max} required class="input" value={f.value} />
              {f.hint && <p class="hint">{f.hint}</p>}
            </div>
          ))
        }
      </div>
      <button class="btn-primary">Saglabāt</button>
    </form>

    <div class="space-y-6">
      <section class="card p-4 sm:p-5">
        <h2 class="text-lg font-semibold">E-pasti</h2>
        {
          mail.provider ? (
            <p class="mt-2 text-sm">
              ✅ Ieslēgti ({providerName[mail.provider]}). Sūtītājs: {mail.fromAddress}
              {business.email.ownerNotifyTo && (
                <>
                  <br />
                  Kopijas īpašniekam: {business.email.ownerNotifyTo}
                </>
              )}
            </p>
          ) : (
            <p class="mt-2 text-sm text-muted">
              Izslēgti – klienti apstiprinājumu redz tikai ekrānā.
              {mail.problem ? (
                <span class="mt-1 block text-red-700">Iemesls: {mail.problem}</span>
              ) : (
                <span class="mt-1 block">
                  Iestatiet <code>EMAIL_PROVIDER</code> (resend vai brevo) un <code>RESEND_API_KEY</code> vai <code>BREVO_API_KEY</code> (sk. README).
                </span>
              )}
            </p>
          )
        }
      </section>

      <form method="POST" action={actions.admin.changePassword} class="card space-y-3 p-4 sm:p-5">
        <h2 class="text-lg font-semibold">Mainīt paroli</h2>
        {errOf(pw) && <p class="alert-error">{errOf(pw)}</p>}
        <div>
          <label class="label" for="password">Jaunā parole</label>
          <input id="password" name="password" type="password" minlength="10" autocomplete="new-password" required class="input" />
        </div>
        <div>
          <label class="label" for="password2">Atkārtojiet paroli</label>
          <input id="password2" name="password2" type="password" minlength="10" autocomplete="new-password" required class="input" />
        </div>
        <button class="btn-outline">Mainīt paroli</button>
      </form>

      <form method="POST" action={actions.admin.anonymizeOld} class="card space-y-3 p-4 sm:p-5" data-confirm="Dzēst klientu datus vecajos pierakstos?">
        <h2 class="text-lg font-semibold">Datu aizsardzība</h2>
        <p class="text-sm text-muted">
          Dzēst klientu vārdus, tālruņus un e-pastus pierakstos, kas vecāki par {s?.retention_months} mēnešiem. Pierakstu statistika saglabājas.
        </p>
        {anon?.error && <p class="alert-error">{anon.error.message}</p>}
        <button class="btn-outline">Dzēst vecos datus</button>
      </form>
    </div>
  </div>
</Admin>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm!)) e.preventDefault();
    }),
  );
</script>
