---
import { business } from '../../config/business';

const h = business.hero;
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_30rem_at_80%_-10%,var(--brand-soft),transparent)]"
    aria-hidden="true"
  >
  </div>
  <div class="container-page grid items-center gap-10 py-12 sm:py-20 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="text-sm font-semibold tracking-wide text-brand uppercase">{h.eyebrow}</p>
      <h1 class="mt-3 text-4xl leading-tight font-semibold sm:text-5xl lg:text-6xl">{h.title}</h1>
      <p class="mt-5 max-w-xl text-lg text-muted">{h.subtitle}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/pieteikties" class="btn-primary px-8 text-lg">{h.ctaPrimary}</a>
        <a href="#pakalpojumi" class="btn-outline px-8 text-lg">{h.ctaSecondary}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink/80">
        {
          h.highlights.map((item) => (
            <li class="flex items-center gap-2">
              <svg class="size-5 text-accent" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z"
                  clip-rule="evenodd"
                />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="relative">
      <img
        src={h.image}
        alt={h.imageAlt}
        width="640"
        height="560"
        fetchpriority="high"
        class="aspect-[8/7] w-full rounded-[2rem] object-cover shadow-xl"
      />
    </div>
  </div>
</section>
