---
import { business } from '../../config/business';
import { t } from '../../config/texts';
import type { ServiceRow } from '../../lib/booking/availability';
import { formatPrice } from '../../lib/format';
import { formatDuration } from '../../lib/time';

interface Props {
  services: ServiceRow[];
}
const { services } = Astro.props;

const groups = new Map<string, ServiceRow[]>();
for (const s of services) {
  const key = s.category || '';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(s);
}
const s = business.sections.services;
---

<section id="pakalpojumi" class="section bg-surface">
  <div class="container-page">
    <h2 class="section-title">{s.title}</h2>
    <p class="section-intro">{s.intro}</p>

    {services.length === 0 && <p class="alert-info mt-8">Pakalpojumu saraksts drīzumā būs pieejams. Zvaniet mums!</p>}

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      {
        [...groups.entries()].map(([category, items]) => (
          <div>
            {category && <h3 class="mb-3 text-xl font-semibold">{category}</h3>}
            <ul class="card divide-y divide-line">
              {items.map((svc) => (
                <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:p-5">
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold">{svc.name}</p>
                    {svc.description && <p class="mt-1 text-sm text-muted">{svc.description}</p>}
                    <p class="mt-1 text-sm text-muted">
                      <span class="sr-only">{t.services.duration}: </span>
                      {formatDuration(svc.duration_min)}
                    </p>
                  </div>
                  <div class="flex items-center justify-between gap-4 sm:flex-col sm:items-end sm:gap-2">
                    <p class="text-lg font-semibold whitespace-nowrap text-brand">{formatPrice(svc.price_eur, svc.price_from)}</p>
                    <a
                      href={`/pieteikties?pakalpojums=${svc.id}`}
                      class="btn-outline !min-h-9 !px-4 !py-1.5 text-sm"
                      aria-label={`${t.services.book}: ${svc.name}`}
                    >
                      {t.services.book}
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
