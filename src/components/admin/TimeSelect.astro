---
/**
 * 24-hour time picker as a <select> (native <input type="time"> follows the
 * device locale and may show AM/PM). Value format: 'HH:mm'.
 */
import { minutesToTime, timeToMinutes } from '../../lib/time';

interface Props {
  name: string;
  value?: string | null;
  id?: string;
  step?: number;
  from?: string;
  to?: string;
  required?: boolean;
  /** Adds an empty option (e.g. optional break). */
  empty?: string;
  label?: string;
  class?: string;
}
const { name, value, id, step = 15, from = '06:00', to = '23:45', required = false, empty, label, class: cls = '' } = Astro.props;
const current = value ? value.slice(0, 5) : '';
const times: string[] = [];
for (let m = timeToMinutes(from); m <= timeToMinutes(to); m += step) times.push(minutesToTime(m));
if (current && !times.includes(current)) {
  times.push(current);
  times.sort();
}
---

<select name={name} id={id} required={required} aria-label={label} class:list={['input !w-auto !px-2 !py-1.5 tabular-nums', cls]}>
  {empty !== undefined && <option value="">{empty}</option>}
  {times.map((t) => <option value={t} selected={t === current}>{t}</option>)}
</select>
